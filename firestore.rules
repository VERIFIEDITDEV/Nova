rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Users may create their profile and update non-balance fields freely.
    // Balance changes for deposits are done by admin in Firebase Console.
    // Trading/swap still update assets client-side (Spark limitation).
    match /users/{id} {
      allow read: if isOwner(id);
      allow create: if isOwner(id)
        && request.resource.data.uid == id
        && request.resource.data.balanceUSD == 0
        && request.resource.data.balanceNGN == 0;
      allow update: if isOwner(id)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Fiat deposits — user creates pending only; admin marks completed + credits balance in Console
    match /deposits/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_review';
      allow update, delete: if false;
    }

    match /transactions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /orders/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /withdrawals/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /blockchainDeposits/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /positions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed';
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
